    {
      "id": "action-prepare",
      "label": "Adjust the seat and mirrors, fasten the seat belt, and confirm the parking brake is set",
      "kind": "Individual"
    },
    {
      "id": "action-start",
      "label": "Check that the gear lever is in neutral; press the clutch fully and start the engine according to the vehicle's instructions",
      "kind": "Individual"
    },
    {
      "id": "action-move-off",
      "label": "Press the clutch fully, select first gear, check mirrors and blind spots, signal if needed, release the parking brake, then raise the clutch slowly to its bite point while gently applying the accelerator; once moving, release the clutch fully",
      "kind": "Individual"
    },
    {
      "id": "action-upshift",
      "label": "Ease off the accelerator, press the clutch fully, select the next gear, then release the clutch smoothly while reapplying the accelerator",
      "kind": "Individual"
    },
    {
      "id": "action-downshift",
      "label": "Brake to a suitable speed, press the clutch fully, select an appropriate lower gear, and release the clutch smoothly; avoid making the engine lug",
      "kind": "Individual"
    },
    {
      "id": "action-stop",
      "label": "Brake progressively and press the clutch fully just before the engine would stall; once stopped, select neutral and secure the car with the parking brake",
      "kind": "Individual"
    },
    {
      "id": "action-park",
      "label": "For parking, use the parking brake and follow the owner's manual about leaving the car in gear; select reverse only when the car is completely stopped",
      "kind": "Individual"
    },
    {
      "id": "note-practice",
      "label": "Practise first with a qualified instructor or licensed supervisor in a legal, quiet practice area",
      "kind": "Individual"
    },
    {
      "id": "note-clutch",
      "label": "Do not rest your foot on the clutch or hold the car on a hill at the bite point; use the brake or parking brake",
      "kind": "Individual"
    },
    {
      "id": "note-shift",
      "label": "Do not force the gear lever or look down while shifting; learn the shift pattern with the car stationary",
      "kind": "Individual"
    },
    {
      "id": "note-coasting",
      "label": "Avoid coasting with the clutch depressed; keep the car in a suitable gear for its speed",
      "kind": "Individual"
    },
