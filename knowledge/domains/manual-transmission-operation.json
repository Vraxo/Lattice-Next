    {
      "id": "action-prepare",
      "label": "Adjust seat and mirrors, fasten seat belt, and set the parking brake",
      "kind": "Individual"
    },
    {
      "id": "action-start",
      "label": "Check neutral; press clutch fully; start engine per the owner's manual",
      "kind": "Individual"
    },
    {
      "id": "action-move-off",
      "label": "Clutch in; select first; check mirrors; release parking brake; find bite point; add throttle; ease out.",
      "kind": "Individual"
    },
    {
      "id": "action-upshift",
      "label": "Ease off accelerator; press clutch fully; select next gear; release smoothly.",
      "kind": "Individual"
    },
    {
      "id": "action-downshift",
      "label": "Brake; press clutch fully; select suitable lower gear; release smoothly.",
      "kind": "Individual"
    },
    {
      "id": "action-stop",
      "label": "Brake progressively; press clutch before stalling; select neutral when stopped",
      "kind": "Individual"
    },
    {
      "id": "action-park",
      "label": "Set parking brake; follow manual on leaving car in gear; reverse only when stopped",
      "kind": "Individual"
    },
    {
      "id": "note-practice",
      "label": "Practise with a qualified instructor or licensed supervisor in a legal, quiet area",
      "kind": "Individual"
    },
    {
      "id": "note-clutch",
      "label": "Do not rest your foot on the clutch or hold on hills at the bite point",
      "kind": "Individual"
    },
    {
      "id": "note-shift",
      "label": "Do not force gears or look down; learn the shift pattern while stationary",
      "kind": "Individual"
    },
    {
      "id": "note-coasting",
      "label": "Avoid coasting with the clutch depressed; use a suitable gear for your speed",
      "kind": "Individual"
    },
