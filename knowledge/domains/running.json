    {
      "id": "running",
      "label": "running",
      "kind": "Individual"
    },
    {
      "id": "running-warm-up",
      "label": "Warm up with five minutes of brisk walking",
      "kind": "Individual"
    },
    {
      "id": "run-walk-intervals",
      "label": "Alternate short, easy jogging intervals with walking",
      "kind": "Individual"
    },
    {
      "id": "conversational-pace",
      "label": "Keep the jogging pace comfortable enough to speak in full sentences",
      "kind": "Individual"
    },
    {
      "id": "recovery-schedule",
      "label": "Begin with two or three sessions per week and leave recovery days between them",
      "kind": "Individual"
    },
    {
      "id": "gradual-progression",
      "label": "Increase the jogging intervals gradually as the routine becomes comfortable",
      "kind": "Individual"
    },
    {
      "id": "warm-up-purpose",
      "label": "prepare the muscles and gradually raise effort",
      "kind": "Individual"
    },
    {
      "id": "run-walk-purpose",
      "label": "build endurance without requiring continuous running at the outset",
      "kind": "Individual"
    },
    {
      "id": "easy-pace-purpose",
      "label": "make the effort sustainable and reduce early overexertion",
      "kind": "Individual"
    },
    {
      "id": "recovery-purpose",
      "label": "allow the body time to recover and adapt between sessions",
      "kind": "Individual"
    },
    {
      "id": "progression-purpose",
      "label": "avoid sudden increases in training load",
      "kind": "Individual"
    },
    {
      "id": "equipment-and-route-safety",
      "label": "Choose comfortable running shoes and a safe, level route",
      "kind": "Individual"
    },
    {
      "id": "medical-safety",
      "label": "If you have a health condition or have been inactive for a long time, seek individual medical advice before beginning",
      "kind": "Individual"
    },
    {
      "id": "warning-symptoms",
      "label": "Stop exercising and seek prompt medical help for chest pain, faintness, or unusual severe breathlessness",
      "kind": "Individual"
    }
  ],
