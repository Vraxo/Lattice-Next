          "character": "\\",
          "replacement": "\\\\"
        },
        {
          "character": "\"",
          "replacement": "\\\""
        },
        {
          "character": "\n",
          "replacement": "\\n"
        },
        {
          "character": "\r",
          "replacement": "\\r"
        },
        {
          "character": "\t",
          "replacement": "\\t"
        }
      ]
    }
