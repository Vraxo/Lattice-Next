  "rules": [
    {
      "id": "python-output-start",
      "contextSuffix": [
        "<|lattice.start|>"
      ],
      "requiredFacts": [
        "language.python",
        "intent.program-generation",
        "program.output",
        "program.output.start"
      ],
      "nextToken": "```python\n",
      "satisfiesFacts": [
        "language.python",
        "intent.program-generation"
      ]
    },
    {
      "id": "python-output-open",
      "contextSuffix": [
        "print"
      ],
      "requiredFacts": [
        "program.output"
      ],
      "nextToken": "("
    },
    {
      "id": "python-output-value",
      "contextSuffix": [
        "print",
        "("
      ],
      "requiredFacts": [
        "program.output",
        "value.output"
      ],
      "tokenBinding": {
        "factId": "value.output",
        "valueId": "content",
        "encoding": "quoted-string"
      },
      "satisfiesFacts": [
        "value.output"
      ]
    },
    {
      "id": "python-output-close",
      "contextSuffix": [],
      "requiredFacts": [
        "program.output"
      ],
      "requiresCompletedFacts": [
        "value.output"
      ],
      "nextToken": ")\n```",
      "satisfiesFacts": [
        "program.output"
      ]
    },
    {
      "id": "python-assignment-target",
      "contextSuffix": [
        "```python\n"
      ],
      "requiredFacts": [
        "language.python",
        "intent.program-generation",
        "program.assignment.target"
      ],
      "requiresCompletedFacts": [],
      "tokenBinding": {
        "factId": "program.assignment.target",
        "valueId": "name"
      },
      "satisfiesFacts": [
        "language.python",
        "intent.program-generation",
        "program.assignment.target"
      ]
    },
    {
      "id": "python-assignment-operator",
      "contextSuffix": [],
      "requiredFacts": [
        "program.assignment.operator"
      ],
      "requiresCompletedFacts": [
        "program.assignment.target"
      ],
      "nextToken": " = ",
      "satisfiesFacts": [
        "program.assignment.operator"
      ]
    },
    {
      "id": "python-assignment-value",
      "contextSuffix": [],
      "requiredFacts": [
        "program.assignment.value"
      ],
      "requiresCompletedFacts": [
        "program.assignment.operator"
      ],
      "tokenBinding": {
        "factId": "program.assignment.value",
        "valueId": "value"
      },
      "satisfiesFacts": [
        "program.assignment.value"
      ]
    },
    {
      "id": "python-assignment-line-end",
      "contextSuffix": [],
      "requiredFacts": [
        "program.assignment"
      ],
      "requiresCompletedFacts": [
        "program.assignment.value"
      ],
      "nextToken": "\n",
      "satisfiesFacts": [
        "program.assignment"
      ]
    },
    {
      "id": "python-output-start-after-assignment",
      "contextSuffix": [],
      "requiredFacts": [
        "program.output",
        "program.output.start"
      ],
      "requiresCompletedFacts": [
        "program.assignment",
        "program.assignment.value"
      ],
      "nextToken": "print",
      "satisfiesFacts": [
        "program.output.start"
      ]
    },
    {
      "id": "python-assignment-prefix",
      "contextSuffix": [
        "<|lattice.start|>"
      ],
      "requiredFacts": [
        "language.python",
        "intent.program-generation",
        "program.assignment.prefix"
      ],
      "nextToken": "```python\n",
      "satisfiesFacts": [
        "program.assignment.prefix"
      ]
    },
    {
      "id": "python-output-call-start",
      "contextSuffix": [
        "```python\n"
      ],
      "requiredFacts": [
        "program.output",
        "program.output.start"
      ],
      "nextToken": "print",
      "satisfiesFacts": [
        "program.output.start"
      ]
    }
  ]
