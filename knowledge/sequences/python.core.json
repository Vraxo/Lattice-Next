{
  "formatVersion": 1,
  "encodings": [
    {
      "id": "quoted-string",
      "openingDelimiter": "\"",
      "closingDelimiter": "\"",
      "escapes": [
        { "character": "\\", "replacement": "\\\\" },
        { "character": "\"", "replacement": "\\\"" },
        { "character": "\n", "replacement": "\\n" },
        { "character": "\r", "replacement": "\\r" },
        { "character": "\t", "replacement": "\\t" }
      ]
    }
  ],
  "inputRules": [
    {
      "id": "recognize-python-language",
      "matchTokens": ["python"],
      "factId": "language.python"
    },
    {
      "id": "recognize-program-output",
      "matchTokens": ["program"],
      "factId": "program.output"
    },
    {
      "id": "recognize-script-output",
      "matchTokens": ["script"],
      "factId": "program.output"
    },
    {
      "id": "recognize-print-operation",
      "matchTokens": ["print"],
      "factId": "program.output"
    },
    {
      "id": "recognize-prints-operation",
      "matchTokens": ["prints"],
      "factId": "program.output"
    },
    {
      "id": "recognize-display-operation",
      "matchTokens": ["display"],
      "factId": "program.output"
    },
    {
      "id": "recognize-output-operation",
      "matchTokens": ["output"],
      "factId": "program.output"
    },
    {
      "id": "capture-printed-value",
      "matchTokens": ["print"],
      "factId": "value.output",
      "valueId": "content"
    },
    {
      "id": "capture-printed-values",
      "matchTokens": ["prints"],
      "factId": "value.output",
      "valueId": "content"
    },
    {
      "id": "capture-displayed-value",
      "matchTokens": ["display"],
      "factId": "value.output",
      "valueId": "content"
    },
    {
      "id": "capture-output-value",
      "matchTokens": ["output"],
      "factId": "value.output",
      "valueId": "content"
    }
  ],
  "rules": [
    {
      "id": "python-output-start",
      "contextSuffix": ["<|lattice.start|>"],
      "requiredFacts": ["language.python", "program.output"],
      "nextToken": "print",
      "satisfiesFacts": ["language.python"]
    },
    {
      "id": "python-output-open",
      "contextSuffix": ["print"],
      "requiredFacts": ["program.output"],
      "nextToken": "("
    },
    {
      "id": "python-output-value",
      "contextSuffix": ["print", "("],
      "requiredFacts": ["program.output", "value.output"],
      "tokenBinding": {
        "factId": "value.output",
        "valueId": "content",
        "encoding": "quoted-string"
      },
      "satisfiesFacts": ["value.output"]
    },
    {
      "id": "python-output-close",
      "contextSuffix": [],
      "requiredFacts": ["program.output"],
      "requiresCompletedFacts": ["value.output"],
      "nextToken": ")",
      "satisfiesFacts": ["program.output"]
    }
  ]
}
