  "rules": [
    {
      "id": "python-output-start",
      "contextSuffix": [
        "<|lattice.start|>"
      ],
      "requiredFacts": [
        "language.python",
        "intent.program-generation",
        "program.output"
      ],
      "nextToken": "```python\nprint",
      "satisfiesFacts": [
        "language.python",
        "intent.program-generation"
      ]
    },
    {
      "id": "python-output-open",
      "contextSuffix": [
        "```python\nprint"
      ],
      "requiredFacts": [
        "program.output"
      ],
      "nextToken": "("
    },
    {
      "id": "python-output-value",
      "contextSuffix": [
        "```python\nprint",
        "("
      ],
      "requiredFacts": [
        "program.output",
        "value.output"
      ],
      "tokenBinding": {
        "factId": "value.output",
        "valueId": "content",
        "encoding": "quoted-string"
      },
      "satisfiesFacts": [
        "value.output"
      ]
    },
    {
      "id": "python-output-close",
      "contextSuffix": [],
      "requiredFacts": [
        "program.output"
      ],
      "requiresCompletedFacts": [
        "value.output"
      ],
      "nextToken": ")\n```",
      "satisfiesFacts": [
        "program.output"
      ]
    }
  ]
}
