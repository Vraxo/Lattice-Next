{
  "formatVersion": 1,
  "encodings": [
    {
      "id": "quoted-string",
      "openingDelimiter": "\"",
      "closingDelimiter": "\"",
      "escapes": [
        {
          "character": "\\",
          "replacement": "\\\\"
        },
        {
          "character": "\"",
          "replacement": "\\\""
        },
        {
          "character": "\n",
          "replacement": "\\n"
        },
        {
          "character": "\r",
          "replacement": "\\r"
        },
        {
          "character": "\t",
          "replacement": "\\t"
        }
      ]
    }
  ],
  "inputRules": [
    {
      "id": "canonicalize-hello-world",
      "matchTokens": [
        "hello",
        "world"
      ],
      "factId": "value.output",
      "valueId": "content",
      "literalValue": "Hello, world!"
    },
