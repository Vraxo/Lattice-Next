<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lattice.Client/Lattice.Client.csproj" />
    <ProjectReference Include="../../src/Lattice.Runtime/Lattice.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/knowledge-packs/ceramics-course-candidates.json"
          Link="ceramics-course-candidates.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/knowledge-packs/laptop-candidates.json"
          Link="laptop-candidates.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/knowledge-packs/day-out-candidates.json"
          Link="day-out-candidates.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
