{
  "protocolVersion": 1,
  "id": "web-search",
  "name": "Web search",
  "description": "Searches the web through a configured SearXNG instance and returns sourced, timestamped results.",
  "command": "python",
  "arguments": [
    "main.py"
  ],
  "inputs": [
    {
      "name": "query",
      "description": "The web search query.",
      "type": "string",
      "required": true
    },
    {
      "name": "max_results",
      "description": "The maximum number of results to return, from 1 to 8.",
      "type": "number",
      "required": false
    }
  ],
  "permissions": [
    "read"
  ],
  "intents": [
    {
      "pattern": "[please] search the web for {query:text}",
      "arguments": {
        "query": "$query"
      },
      "response": "{result}"
    },
    {
      "pattern": "look up {query:text} on the web",
      "arguments": {
        "query": "$query"
      },
      "response": "{result}"
    }
  ]
}
