      "arguments": {
        "left": "$left",
        "operation": "multiply",
        "right": "$right"
      },
      "response": "{left} multiplied by {right} is {result}."
    },
    {
      "pattern": "multiply {left:number} by {right:number}",
      "arguments": {
        "left": "$left",
        "operation": "multiply",
        "right": "$right"
      },
      "response": "{left} multiplied by {right} is {result}."
