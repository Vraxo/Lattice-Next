    {
      "pattern": "{left:number} plus {right:number}",
      "arguments": {
        "left": "$left",
        "operation": "add",
        "right": "$right"
      },
      "response": "{left} plus {right} is {result}."
    },
    {
      "pattern": "add {left:number} and {right:number}",
      "arguments": {
        "left": "$left",
        "operation": "add",
        "right": "$right"
      },
      "response": "{left} plus {right} is {result}."
