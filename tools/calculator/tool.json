      "pattern": "divide {left:number} by {right:number}",
      "arguments": {
        "left": "$left",
        "operation": "divide",
        "right": "$right"
      },
      "response": "{left} divided by {right} is {result}."
    },
    {
      "pattern": "multiply that by {right:number}",
      "arguments": {
        "left": "$previous",
