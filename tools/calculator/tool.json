      "pattern": "subtract {right:number} from {left:number}",
      "arguments": {
        "left": "$left",
        "operation": "subtract",
        "right": "$right"
      },
      "response": "{left} minus {right} is {result}."
    },
    {
      "pattern": "what is {left:number} divided by {right:number}",
      "arguments": {
        "left": "$left",
        "operation": "divide",
        "right": "$right"
      },
      "response": "{left} divided by {right} is {result}."
