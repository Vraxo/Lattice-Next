{
  "protocolVersion": 1,
  "id": "unit-converter",
  "name": "Unit converter",
  "description": "Converts values between supported units of the same dimension.",
  "command": "python",
  "arguments": [
    "main.py"
  ],
  "inputs": [
    {
      "name": "value",
      "description": "The numeric value to convert.",
      "type": "number",
      "required": true
    },
    {
      "name": "from",
      "description": "The source unit.",
      "type": "string",
      "required": true
    },
    {
      "name": "to",
      "description": "The destination unit.",
      "type": "string",
      "required": true
    }
  ],
  "permissions": [],
  "intents": [
    {
      "pattern": "convert {value:number} {from:word} to {to:word}",
      "arguments": {
        "value": "$value",
        "from": "$from",
        "to": "$to"
      },
      "response": "{value} {from} is {result} {to}."
    },
    {
      "pattern": "how many {to:word} is {value:number} {from:word}",
      "arguments": {
        "value": "$value",
        "from": "$from",
        "to": "$to"
      },
      "response": "{value} {from} is {result} {to}."
    },
    {
      "pattern": "{value:number} {from:word} in {to:word}",
      "arguments": {
        "value": "$value",
        "from": "$from",
        "to": "$to"
      },
      "response": "{value} {from} is {result} {to}."
    }
  ]
}
