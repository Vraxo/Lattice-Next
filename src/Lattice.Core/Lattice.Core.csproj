<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Language/Resources/english-lexicon.json"
                      LogicalName="Lattice.Core.Language.english-lexicon.json" />
    <EmbeddedResource Include="../../knowledge/languages/**/*.json"
                      LogicalName="Lattice.Core.GenerationKnowledge.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../knowledge/sequences/**/*.json"
                      LogicalName="Lattice.Core.SequenceKnowledge.%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Lattice.Core.Tests" />
  </ItemGroup>

</Project>
